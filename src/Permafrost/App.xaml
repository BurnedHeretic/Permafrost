<Application x:Class="Permafrost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#24272C"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#2D3137"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#41464F"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="#1E2024"/>
            <Setter Property="Foreground" Value="#E7E7E7"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7E7E7"/></Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,4"/>
        </Style>
    </Application.Resources>
</Application>
